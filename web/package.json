{
  "name": "@hanzo/cyber-web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Standalone pure TypeScript @hanzo/gui console for Hanzo Cyber",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.18"
  },
