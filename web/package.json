    "@hanzo/i18n": "0.6.1",
    "@hanzo/ui": "8.33.11",
    "@hanzogui/core": "8.4.5",
    "@hanzogui/react-native-svg": "8.4.5",
    "@hanzogui/react-native-web-lite": "8.4.5",
    "@hanzogui/web": "8.4.5",
    "lucide-react": "^1.44.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/node": "26.5.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "esbuild": "^0.28.0",
    "typescript": "7.0.2"
